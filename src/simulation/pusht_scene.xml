<mujoco model="actionworld_lite_pusht">
  <compiler angle="radian"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="640" offheight="480"/>
  </visual>

  <worldbody>
    <light name="main_light" pos="0 0 2"/>

    <camera
      name="top"
      mode="fixed"
      pos="0 0 2.0"
      quat="1 0 0 0"
      fovy="35"/>

    <geom
      name="floor"
      type="plane"
      size="1.25 1.25 0.1"
      rgba="0.85 0.89 0.88 1"
      friction="0.9 0.01 0.001"/>

    <site
      name="goal"
      type="sphere"
      pos="0.32 0 0.005"
      size="0.03"
      rgba="0.2 0.7 0.3 0.5"/>

    <body name="t_block" pos="0 0 0.025">
      <freejoint name="t_free"/>

      <geom
        name="t_bar"
        type="box"
        pos="0 0.045 0"
        size="0.095 0.025 0.025"
        density="600"
        friction="0.8 0.01 0.001"
        rgba="0.85 0.35 0.2 1"/>

      <geom
        name="t_stem"
        type="box"
        pos="0 -0.02 0"
        size="0.025 0.06 0.025"
        density="600"
        friction="0.8 0.01 0.001"
        rgba="0.85 0.35 0.2 1"/>
    </body>

    <body name="pusher" mocap="true" pos="-0.20 0 0.04">
      <geom
        name="pusher_geom"
        type="cylinder"
        size="0.025 0.035"
        rgba="0.2 0.45 0.85 1"/>
    </body>
  </worldbody>
</mujoco>
